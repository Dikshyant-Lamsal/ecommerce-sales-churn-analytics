# PostgreSQL used by the existing Part 1 dashboard / ETL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_dw
DB_USER=etl_user
DB_PASSWORD=replace_with_your_local_password

# Part 2 MLflow (when training from the host while docker-compose is running)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ecommerce-customer-churn
MLFLOW_MODEL_NAME=EcommerceChurnClassifier

# Optional: point to a cleaned CSV instead of the default data paths
# TRAINING_DATA_PATH=data/staging/cleaned_transactions.csv
